<div class="pipe-wrap">
<svg class="pipe" viewBox="0 0 1000 300" role="img" aria-labelledby="pipe-title">
  <title id="pipe-title">source text to parse to Document to Layout, then to paint for the screen or print for stdout</title>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill="currentColor"/>
    </marker>
  </defs>
  <g class="pipe-edges" fill="none" stroke-width="1.5" marker-end="url(#arrow)">
    <path d="M150 150 H210"/>
    <path d="M330 150 H390"/>
    <path d="M540 150 H600"/>
    <path d="M760 150 C800 150 800 80 840 80"/>
    <path d="M760 150 C800 150 800 220 840 220"/>
  </g>
  <g class="pipe-nodes">
    <g transform="translate(20 115)"><rect width="130" height="70" rx="14"/><text x="65" y="42">source text</text></g>
    <g transform="translate(210 115)"><rect width="120" height="70" rx="14"/><text x="60" y="42">parse</text></g>
    <g transform="translate(390 115)" class="node-key"><rect width="150" height="70" rx="14"/><text x="75" y="42">Document</text></g>
    <g transform="translate(600 115)" class="node-key"><rect width="160" height="70" rx="14"/><text x="80" y="42">Layout</text></g>
    <g transform="translate(840 45)" class="node-out"><rect width="140" height="70" rx="14"/><text x="70" y="42">paint</text></g>
    <g transform="translate(840 185)" class="node-out"><rect width="140" height="70" rx="14"/><text x="70" y="42">print</text></g>
  </g>
  <g class="pipe-notes">
    <text x="85" y="215">Markdown</text>
    <text x="270" y="215">pulldown-cmark</text>
    <text x="465" y="215">blocks with byte ranges</text>
    <text x="680" y="215">lines, anchors, links</text>
    <text x="910" y="135">ratatui frame</text>
    <text x="910" y="275">ANSI on stdout</text>
  </g>
</svg>
</div>
