<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.url == '/' %}mido: {{ site.tagline }}{% else %}{{ title }} | mido{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#070d22">
  <meta property="og:title" content="{% if page.url == '/' %}mido{% else %}{{ title }} | mido{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/icon-1024.png">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/assets/img/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/img/icon-1024.png">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ bodyClass }}">
  <div class="sky" aria-hidden="true"><i></i><i></i><i></i></div>
  {% include "partials/topbar.njk" %}
  {{ content | safe }}
  {% include "partials/footer.njk" %}
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
