Output docs/assets/img/demo.mp4
Output docs/assets/img/demo.webm

Set Shell "bash"
Set FontSize 15
Set Width 1200
Set Height 700
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms
Set Framerate 30

Type "mido docs/"
Sleep 600ms
Enter
Sleep 2200ms

Ctrl+p
Sleep 500ms
Type "getting"
Sleep 700ms
Enter
Sleep 1800ms

Down@110ms 12
Sleep 900ms

Type "t"
Sleep 1400ms
Down@220ms 3
Enter
Sleep 1500ms

Type "]"
Sleep 500ms
Type "]"
Sleep 500ms
Enter
Sleep 1800ms
Type "H"
Sleep 1200ms

Type "/"
Type "outline"
Sleep 500ms
Enter
Sleep 1200ms
Type "n"
Sleep 900ms

Ctrl+p
Sleep 500ms
Type "keys"
Sleep 700ms
Enter
Sleep 1800ms

Type "?"
Sleep 2200ms
Escape
Sleep 400ms
Type "q"
Sleep 400ms
